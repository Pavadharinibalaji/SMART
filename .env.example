# ==============================================================================
# SMART 2.0 — Environment Configuration Example
# ==============================================================================
# Copy this file to .env in production or staging environments:
#   cp .env.example .env
#
# All variables have safe local development defaults.
# ==============================================================================

# Backend Server Configuration
HOST=127.0.0.1
PORT=8000

# Database Persistence Path
# Path to the SQLite database file. Created automatically on application startup.
# Defaults to backend/data/smart.db
SMART_DB_PATH=backend/data/smart.db

# Cryptographic Provenance Secret (HMAC SHA-256)
# 32-byte hex-encoded secret used to sign and verify candidate extraction tokens.
# If left empty, SMART generates a secure ephemeral runtime key on each server boot.
# For multi-process deployments or persistent candidate verification across restarts,
# generate and set a permanent 64-character hex secret:
#   python -c "import secrets; print(secrets.token_hex(32))"
SMART_PROVENANCE_SECRET=

# Frontend Configuration (for Vite client development and builds)
# Base URL for the SMART backend API
VITE_API_URL=http://127.0.0.1:8000
